{
  "$defs": {
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EvidenceType": {
      "description": "Supported source surfaces for a research statement.",
      "enum": [
        "TEXT",
        "TABLE",
        "FIGURE",
        "EQUATION",
        "APPENDIX",
        "METADATA"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "EvidenceVerification": {
      "additionalProperties": false,
      "description": "Result of checking an EvidenceSpan against a supplied PaperDocument.",
      "properties": {
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "source_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Match"
        },
        "page_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Resolved"
        },
        "block_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Resolved"
        },
        "char_range_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Range Resolved"
        },
        "quote_match": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Match"
        },
        "text_hash_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Hash Match"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "verifier_version": {
          "default": "0.3.0",
          "title": "Verifier Version",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "EvidenceVerification",
      "type": "object"
    },
    "TraceabilityScore": {
      "additionalProperties": false,
      "description": "Locator-specificity score; it is not a truth or study-quality score.",
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "scoring_version": {
          "const": "1",
          "default": "1",
          "title": "Scoring Version",
          "type": "string"
        }
      },
      "required": [
        "score",
        "level",
        "reasons"
      ],
      "title": "TraceabilityScore",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "partial",
        "failed",
        "not_run"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Normalized evidence node referenced by ID from v0.3 research objects.",
  "properties": {
    "evidence_id": {
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "page": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page"
    },
    "section_path": {
      "items": {
        "type": "string"
      },
      "title": "Section Path",
      "type": "array"
    },
    "block_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Block Id"
    },
    "char_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char Start"
    },
    "char_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char End"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "table": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Table"
    },
    "column": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Column"
    },
    "figure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Figure"
    },
    "equation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Equation"
    },
    "appendix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Appendix"
    },
    "quoted_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quoted Text"
    },
    "text_hash": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text Hash"
    },
    "traceability": {
      "anyOf": [
        {
          "$ref": "#/$defs/TraceabilityScore"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verification": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvidenceVerification"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "evidence_id",
    "source_id",
    "type"
  ],
  "title": "EvidenceSpan",
  "type": "object"
}
