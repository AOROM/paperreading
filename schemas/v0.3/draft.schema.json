{
  "$defs": {
    "DraftStatus": {
      "enum": [
        "extracted",
        "needs_review",
        "ready_to_finalize"
      ],
      "title": "DraftStatus",
      "type": "string"
    },
    "ExtractionCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "extractor": {
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "candidate_id",
        "field_path",
        "value",
        "extractor"
      ],
      "title": "ExtractionCandidate",
      "type": "object"
    },
    "ExtractionConflict": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Candidate Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "candidate_ids",
        "reason"
      ],
      "title": "ExtractionConflict",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.3",
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "draft_id": {
      "minLength": 1,
      "title": "Draft Id",
      "type": "string"
    },
    "source_id": {
      "minLength": 1,
      "title": "Source Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DraftStatus",
      "default": "extracted"
    },
    "candidates": {
      "items": {
        "$ref": "#/$defs/ExtractionCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "unresolved_fields": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Fields",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/ExtractionConflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "issues": {
      "items": {
        "type": "string"
      },
      "title": "Issues",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "draft_id",
    "source_id",
    "created_at"
  ],
  "title": "PaperDraft",
  "type": "object"
}
