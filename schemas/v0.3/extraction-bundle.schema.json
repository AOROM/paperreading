{
  "$defs": {
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DraftStatus": {
      "enum": [
        "extracted",
        "needs_review",
        "ready_to_finalize"
      ],
      "title": "DraftStatus",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "description": "Normalized evidence node referenced by ID from v0.3 research objects.",
      "properties": {
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EvidenceType"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section_path": {
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "figure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure"
        },
        "equation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equation"
        },
        "appendix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appendix"
        },
        "quoted_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quoted Text"
        },
        "text_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Hash"
        },
        "traceability": {
          "anyOf": [
            {
              "$ref": "#/$defs/TraceabilityScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceVerification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "evidence_id",
        "source_id",
        "type"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "EvidenceType": {
      "description": "Supported source surfaces for a research statement.",
      "enum": [
        "TEXT",
        "TABLE",
        "FIGURE",
        "EQUATION",
        "APPENDIX",
        "METADATA"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "EvidenceVerification": {
      "additionalProperties": false,
      "description": "Result of checking an EvidenceSpan against a supplied PaperDocument.",
      "properties": {
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "source_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Match"
        },
        "page_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Resolved"
        },
        "block_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Resolved"
        },
        "char_range_resolved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Range Resolved"
        },
        "quote_match": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Match"
        },
        "text_hash_match": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Hash Match"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "verifier_version": {
          "default": "0.3.1",
          "title": "Verifier Version",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "EvidenceVerification",
      "type": "object"
    },
    "ExtractionCandidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {
          "minLength": 1,
          "title": "Candidate Id",
          "type": "string"
        },
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "extractor": {
          "minLength": 1,
          "title": "Extractor",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        }
      },
      "required": [
        "candidate_id",
        "field_path",
        "value",
        "extractor"
      ],
      "title": "ExtractionCandidate",
      "type": "object"
    },
    "ExtractionConflict": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "minLength": 1,
          "title": "Field Path",
          "type": "string"
        },
        "candidate_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Candidate Ids",
          "type": "array"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "field_path",
        "candidate_ids",
        "reason"
      ],
      "title": "ExtractionConflict",
      "type": "object"
    },
    "ExtractionStage": {
      "enum": [
        "metadata",
        "research_questions",
        "theory",
        "data",
        "variables",
        "design",
        "findings",
        "mechanisms",
        "heterogeneity",
        "robustness",
        "limitations",
        "analysis"
      ],
      "title": "ExtractionStage",
      "type": "string"
    },
    "JsonValue": {},
    "PaperDraft": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "0.3",
          "default": "0.3",
          "title": "Schema Version",
          "type": "string"
        },
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DraftStatus",
          "default": "extracted"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ExtractionCandidate"
          },
          "title": "Candidates",
          "type": "array"
        },
        "unresolved_fields": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Fields",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/ExtractionConflict"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "draft_id",
        "source_id",
        "created_at"
      ],
      "title": "PaperDraft",
      "type": "object"
    },
    "TraceabilityScore": {
      "additionalProperties": false,
      "description": "Locator-specificity score; it is not a truth or study-quality score.",
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "scoring_version": {
          "const": "1",
          "default": "1",
          "title": "Scoring Version",
          "type": "string"
        }
      },
      "required": [
        "score",
        "level",
        "reasons"
      ],
      "title": "TraceabilityScore",
      "type": "object"
    },
    "VerificationStatus": {
      "enum": [
        "verified",
        "partial",
        "failed",
        "not_run"
      ],
      "title": "VerificationStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Keep draft candidates, evidence, and run identity together.",
  "properties": {
    "schema_version": {
      "const": "0.3",
      "default": "0.3",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "canonical_text_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Canonical Text Sha256",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/PaperDraft"
    },
    "evidence_index": {
      "additionalProperties": {
        "$ref": "#/$defs/EvidenceSpan"
      },
      "title": "Evidence Index",
      "type": "object"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "provider_version": {
      "minLength": 1,
      "title": "Provider Version",
      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model"
    },
    "extraction_stages": {
      "items": {
        "$ref": "#/$defs/ExtractionStage"
      },
      "minItems": 1,
      "title": "Extraction Stages",
      "type": "array"
    },
    "prompt_versions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompt Versions",
      "type": "object"
    }
  },
  "required": [
    "document_id",
    "canonical_text_sha256",
    "draft",
    "provider",
    "provider_version",
    "extraction_stages"
  ],
  "title": "ExtractionBundle",
  "type": "object"
}
