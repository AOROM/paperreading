        "language": {
          "default": "zh-CN",
          "title": "Language",
          "type": "string"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "rankings": {
          "items": {
            "$ref": "#/$defs/RankingEvidence"
