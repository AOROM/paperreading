        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "figure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Figure"
        },
        "equation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equation"
        },
        "appendix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Appendix"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "confidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source_id",
        "type"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceType": {
      "description": "Supported source surfaces for a research statement.",
      "enum": [
        "TEXT",
        "TABLE",
        "FIGURE",
        "EQUATION",
        "APPENDIX",
        "METADATA"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "relationship": {
          "$ref": "#/$defs/Relationship"
        },
        "coefficient": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coefficient"
        },
        "significance": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Significance"
        },
        "causal": {
          "default": false,
          "title": "Causal",
          "type": "boolean"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "relationship",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "GapType": {
      "enum": [
        "method_gap",
        "data_gap",
        "variable_gap",
        "mechanism_gap",
        "context_gap",
        "identification_gap",
        "external_validity_gap",
        "temporal_gap",
        "measurement_gap",
        "theory_gap",
        "contradictory_evidence"
      ],
      "title": "GapType",
      "type": "string"
    },
    "Mechanism": {
      "additionalProperties": false,
      "properties": {
