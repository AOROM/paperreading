{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "description": "Rule-derived confidence, not an unconstrained model opinion.",
      "properties": {
        "score": {
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "score",
        "level",
        "reasons"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "DataDescription": {
      "additionalProperties": false,
      "properties": {
        "sample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "exclusions": {
          "items": {
            "type": "string"
          },
          "title": "Exclusions",
          "type": "array"
        }
      },
      "title": "DataDescription",
      "type": "object"
    },
    "DesignType": {
      "enum": [
        "ols",
        "panel_fe",
        "did",
        "staggered_did",
        "iv",
        "rdd",
        "psm",
        "event_study",
        "rct",
        "qualitative",
        "other"
      ],
      "title": "DesignType",
      "type": "string"
    },
    "EmpiricalDesign": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/DesignType"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "model_equation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Equation"
        },
        "fixed_effects": {
          "items": {
            "type": "string"
          },
          "title": "Fixed Effects",
          "type": "array"
        },
        "standard_errors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Errors"
        },
        "identification_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identification Strategy"
        },
        "endogeneity_methods": {
          "items": {
            "type": "string"
          },
          "title": "Endogeneity Methods",
          "type": "array"
        },
        "robustness_checks": {
          "items": {
            "type": "string"
          },
          "title": "Robustness Checks",
          "type": "array"
        }
      },
      "required": [
        "type",
        "method"
      ],
      "title": "EmpiricalDesign",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A source-aware locator for one claim or reported result.",
