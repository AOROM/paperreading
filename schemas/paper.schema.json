  "additionalProperties": false,
  "description": "Canonical record; legacy Excel columns are only a projection of this model.",
  "properties": {
    "schema_version": {
      "const": "0.2",
      "default": "0.2",
      "title": "Schema Version",
      "type": "string"
    },
    "paper_id": {
      "minLength": 1,
      "title": "Paper Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/PaperMetadata"
    },
    "research_questions": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "title": "Research Questions",
      "type": "array"
    },
    "theoretical_framework": {
      "$ref": "#/$defs/Theory"
    },
    "data": {
      "$ref": "#/$defs/DataDescription"
    },
    "variables": {
      "items": {
        "$ref": "#/$defs/Variable"
      },
      "minItems": 1,
      "title": "Variables",
      "type": "array"
    },
    "empirical_design": {
      "$ref": "#/$defs/EmpiricalDesign"
    },
    "source_claims": {
      "items": {
        "$ref": "#/$defs/SourceClaim"
      },
      "minItems": 1,
      "title": "Source Claims",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "mechanisms": {
      "items": {
        "$ref": "#/$defs/Mechanism"
      },
      "title": "Mechanisms",
      "type": "array"
    },
    "heterogeneity": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Heterogeneity",
      "type": "array"
    },
    "robustness": {
      "items": {
        "$ref": "#/$defs/TestResult"
      },
      "title": "Robustness",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/ResearchExtension"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Extensions",
      "type": "array"
    },
    "researcher_assessment": {
      "items": {
        "type": "string"
      },
      "title": "Researcher Assessment",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Evidence",
      "type": "array"
    }
